  "bases": {
    "alfabeto": [
      "Cuatro tonos más el neutro cambian el significado: 1.º alto y plano (mā 妈 mamá), 2.º ascendente como pregunta (má 麻), 3.º baja y sube (mǎ 马 caballo), 4.º descendente y seco como orden (mà 骂 regañar). La guía no muestra tonos: apréndelos del pinyin.",
      "b, d, g suenan sordas como p, t, k suaves sin soplo; p, t, k llevan un soplo fuerte de aire. Por eso la guía escribe 爸 bà como «pa».",
      "x ≈ «sh» suave con la lengua en los dientes de abajo; q ≈ «ch» con soplo; j ≈ «ch» sin soplo. zh, ch, sh, r se dicen con la punta de la lengua doblada hacia atrás.",
      "z ≈ «ts» sin soplo, c ≈ «ts» con soplo fuerte. La «r» se parece a la «y» rioplatense suave, nunca vibrante.",
      "ü (escrita u después de j, q, x, y): una «i» con los labios redondeados como para decir «u» (como la ü alemana). La «e» sola suena como una «e» oscura, entre «e» y «a» sin redondear.",
      "Cada carácter es una sílaba con significado; no hay alfabeto. Se aprenden por componentes (radicales) y por trazos en orden fijo."
    ],
    "verbos": [
      {"inf": "是", "r": "shì", "es": "ser", "formas": [["afirmativo", "我是学生 (wǒ shì xuésheng)", "uo SHI shue-sheng"], ["pasado con 了", "以前我是学生 (yǐqián wǒ shì xuésheng; 是 no lleva 了)", "i-CHIEN uo SHI shue-sheng"], ["negativo con 不", "我不是学生 (wǒ bú shì xuésheng)", "uo pu SHI shue-sheng"], ["pregunta con 吗", "你是学生吗？ (nǐ shì xuésheng ma?)", "ni SHI shue-sheng ma"]]},
      {"inf": "在", "r": "zài", "es": "estar (en un lugar)", "formas": [["afirmativo", "我在家 (wǒ zài jiā)", "uo tsai CHIA"], ["pasado con 了", "我刚才在家 (wǒ gāngcái zài jiā; 在 no suele llevar 了)", "uo kang-TSAI tsai CHIA"], ["negativo con 不", "我不在家 (wǒ bú zài jiā)", "uo pu tsai CHIA"], ["pregunta con 吗", "你在家吗？ (nǐ zài jiā ma?)", "ni tsai CHIA ma"]]},
      {"inf": "有", "r": "yǒu", "es": "tener / haber", "formas": [["afirmativo", "我有水 (wǒ yǒu shuǐ)", "uo YOU shuei"], ["pasado con 了", "我有了水 (wǒ yǒu le shuǐ)", "uo YOU le shuei"], ["negativo con 没", "我没有水 (wǒ méiyǒu shuǐ)", "uo mei-YOU shuei"], ["pregunta con 吗", "你有水吗？ (nǐ yǒu shuǐ ma?)", "ni YOU shuei ma"]]},
      {"inf": "去", "r": "qù", "es": "ir", "formas": [["afirmativo", "我去医院 (wǒ qù yīyuàn)", "uo chü i-YUEN"], ["pasado con 了", "我去了医院 (wǒ qù le yīyuàn)", "uo CHÜ le i-YUEN"], ["negativo con 不/没", "我不去 / 我没去 (wǒ bú qù / wǒ méi qù)", "uo pu CHÜ / uo mei CHÜ"], ["pregunta con 吗", "你去吗？ (nǐ qù ma?)", "ni CHÜ ma"]]},
      {"inf": "做", "r": "zuò", "es": "hacer", "formas": [["afirmativo", "我做饭 (wǒ zuò fàn)", "uo tsuo FAN"], ["pasado con 了", "我做了饭 (wǒ zuò le fàn)", "uo TSUO le fan"], ["negativo con 不/没", "我不做 / 我没做 (wǒ bú zuò / wǒ méi zuò)", "uo pu TSUO / uo mei TSUO"], ["pregunta con 吗", "你做饭吗？ (nǐ zuò fàn ma?)", "ni tsuo FAN ma"]]},
      {"inf": "想要", "r": "xiǎngyào", "es": "querer", "formas": [["afirmativo", "我想要茶 (wǒ xiǎngyào chá)", "uo shiang-YAO cha"], ["pasado con 了", "我想要了很久 (wǒ xiǎngyào le hěn jiǔ)", "uo shiang-YAO le jen CHIOU"], ["negativo con 不", "我不想要 (wǒ bù xiǎngyào)", "uo pu shiang-YAO"], ["pregunta con 吗", "你想要茶吗？ (nǐ xiǎngyào chá ma?)", "ni shiang-YAO cha ma"]]},
