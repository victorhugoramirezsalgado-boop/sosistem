      {"inf": "ذهب", "r": "dhahaba", "es": "ir", "formas": [["yo", "أذهب (adhhab)", "AD-jab"], ["tú", "تذهب (tadhhab)", "TAD-jab"], ["él/ella", "يذهب/تذهب (yadhhab/tadhhab)", "YAD-jab/TAD-jab"], ["nosotros", "نذهب (nadhhab)", "NAD-jab"], ["ustedes/vosotros", "تذهبون (tadhhabuun)", "tad-ja-BUN"], ["ellos/ellas", "يذهبون (yadhhabuun)", "yad-ja-BUN"]]},
