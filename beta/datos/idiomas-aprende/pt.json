    "ruta": [
      {"nivel": "A1", "titulo": "Primeros pasos: presentarse y frases básicas", "puntos": [
        "El orden es sujeto + verbo + complemento, igual que en español: 'Eu falo português'.",
        "Artículos: o / a (el / la), os / as (los / las), um / uma (un / una); se contraen con preposiciones: de + o = do, em + a = na.",
        "En Brasil 'tú' se dice 'você' y se conjuga como 'él' (você fala); 'ustedes' es 'vocês'.",
        "Negación: 'não' antes del verbo; en el habla es común repetirlo al final: 'Não sei, não'.",
        "Preguntas: misma frase con entonación de pregunta; sólo hay signo de interrogación al final (?).",
        "Plural general con -s: casa → casas; las palabras en -ão suelen hacer -ões (coração → corações)."
      ], "ejemplos": [
        ["Eu me chamo Ana.", "Eu me chamo Ana.", "eu mi SHA-mu A-na", "Me llamo Ana."],
        ["Você fala espanhol?", "Você fala espanhol?", "vo-SE FA-la es-pa-ÑOU", "¿Hablas español?"],
        ["Eu não entendo.", "Eu não entendo.", "eu NAUN en-TEN-du", "No entiendo."]
      ]},
      {"nivel": "A2", "titulo": "Vida diaria: pasado, futuro cercano y gustos", "puntos": [
        "Pretérito perfeito para acciones terminadas: falei, comi, fui ('Ontem eu comi pão').",
        "Futuro cercano con ir + infinitivo: 'Vou trabalhar amanhã' (más usado que el futuro simple).",
        "Gerundio en Brasil con estar + -ndo: 'Estou comendo' (estoy comiendo).",
        "'Gostar de' = gustar, pero la persona es el sujeto: 'Eu gosto de café' (me gusta el café).",
        "Pronombres de objeto suelen ir antes del verbo en Brasil: 'Ele me ajudou'.",
        "Falsos amigos frecuentes: 'esquisito' = raro, 'exquisito' en español es 'delicioso'; 'polvo' = pulpo."
      ], "ejemplos": [
        ["Ontem eu fui ao porto.", "Ontem eu fui ao porto.", "ON-tein eu FUI au POR-tu", "Ayer fui al puerto."],
        ["Vou trabalhar amanhã.", "Vou trabalhar amanhã.", "vou tra-ba-LIAR a-ma-ÑAN", "Voy a trabajar mañana."],
        ["Eu gosto de café.", "Eu gosto de café.", "eu GOS-tu dji ka-FE", "Me gusta el café."]
      ]},
      {"nivel": "B1", "titulo": "Independencia: opiniones, imperfecto y subjuntivo", "puntos": [
        "Pretérito imperfeito para costumbres y descripciones del pasado: 'Quando eu era criança, morava no Brasil'.",
