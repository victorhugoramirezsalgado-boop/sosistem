    "ruta": [
      {"nivel": "A1", "titulo": "Primeros pasos: presentarse y pedir ayuda", "puntos": [
        "El verbo no cambia según la persona: jag är, du är, vi är (solo cambia el pronombre).",
        "Orden básico sujeto–verbo–objeto: Jag äter bröd.",
        "Dos géneros: común (en) y neutro (ett): en man, ett hus. Se aprende el género con cada palabra.",
        "El artículo definido va pegado al final: en man → mannen (el hombre), ett hus → huset (la casa).",
        "Negación con «inte» después del verbo: Jag förstår inte.",
        "Preguntas invirtiendo verbo y sujeto: Talar du spanska?"
      ], "ejemplos": [
        ["Jag heter Ana.", "Jag heter Ana.", "ya HE-ter A-na", "Me llamo Ana."],
        ["Talar du spanska?", "Talar du spanska?", "¿TA-lar du SPANS-ka?", "¿Hablas español?"],
        ["Jag behöver hjälp.", "Jag behöver hjälp.", "ya be-HÖ-ver YELP", "Necesito ayuda."]
      ]},
      {"nivel": "A2", "titulo": "Vida diaria: pasado, plural y cortesía", "puntos": [
        "Cinco grupos de plural: -or (flicka → flickor), -ar (dag → dagar), -er (stad → städer), -n (äpple → äpplen), sin cambio (hus → hus).",
        "Regla V2: el verbo va siempre en segunda posición; si se empieza con tiempo o lugar, el sujeto va detrás: I dag arbetar jag.",
        "Pasado (preteritum) con -de/-te/-dde: arbeta → arbetade, läsa → läste, bo → bodde; irregulares: gå → gick, vara → var.",
        "Perfecto con «har» + supino: Jag har ätit. Vi har varit där.",
        "Cortesía: se tutea casi siempre con «du»; para pedir se usa «Kan jag få…?» (¿Me da…?) y se agradece con «tack»."
      ], "ejemplos": [
        ["I går var jag på sjukhuset.", "I går var jag på sjukhuset.", "i-GOR var ya po JUK-hu-set", "Ayer estuve en el hospital."],
        ["Kan jag få ett glas vatten?", "Kan jag få ett glas vatten?", "¿kan ya FO et glas VA-ten?", "¿Me da un vaso de agua?"],
        ["Var ligger apoteket?", "Var ligger apoteket?", "¿var LI-guer a-pu-TE-ket?", "¿Dónde está la farmacia?"]
      ]},
      {"nivel": "B1", "titulo": "Independencia: futuro, subordinadas y opiniones", "puntos": [
        "Futuro con «ska» (plan) o «kommer att» (predicción) + infinitivo: Jag ska resa i morgon. Det kommer att regna.",
        "En subordinadas (att, eftersom, när, om) «inte» va ANTES del verbo: …eftersom jag inte har tid.",
        "Adjetivos concuerdan: en stor stad, ett stort hus, stora städer; forma definida con doble artículo: den stora staden.",
        "Verbos en -s para pasiva o reciprocidad: Affären stängs klockan 18. Vi ses!",
        "Opinar y argumentar: Jag tycker att…; Jag tror att…; å ena sidan… å andra sidan…"
      ], "ejemplos": [
        ["Jag tycker att svenska är svårt men roligt.", "Jag tycker att svenska är svårt men roligt.", "ya TÜ-ker at SVENS-ka er SVORT men RU-lit", "Me parece que el sueco es difícil pero divertido."],
        ["Om det brinner ska du ringa 112.", "Om det brinner ska du ringa 112.", "om de BRI-ner ska du RING-a et-et-TVO", "Si hay un incendio, debes llamar al 112."],
        ["Han kom inte eftersom han inte hade tid.", "Han kom inte eftersom han inte hade tid.", "han KOM IN-te EF-ter-som han IN-te HA-de TID", "No vino porque no tenía tiempo."]
      ]}
    ]
