    "ruta": [
      {"nivel": "A1", "titulo": "Primeros pasos: presentarse y frases básicas", "puntos": [
        "El orden es sujeto + verbo + complemento, como en español; el pronombre sujeto suele omitirse: '(Jo) parlo català'.",
        "Artículos: el / la / l' (el, la; l' delante de vocal o h), els / les (los, las), un / una; artículo personal en el habla: 'en Joan', 'la Maria'.",
        "Plural general con -s; los masculinos acabados en -s, -ç, -x añaden -os (gos → gossos) y las palabras en -a hacen -es (casa → cases).",
        "Negación con 'no' antes del verbo; 'pas' puede reforzarla: 'No ho sé'.",
        "Preguntas con entonación y signo sólo al final (?): 'Parles castellà?'; tratamiento formal con 'vostè' (verbo en 3.ª persona).",
        "Contracciones obligatorias: a + el = al, de + el = del, per + el = pel."
      ], "ejemplos": [
        ["Em dic Anna.", "Em dic Anna.", "em DIK A-na", "Me llamo Anna."],
        ["Parles castellà?", "Parles castellà?", "PAR-les kas-te-LLA", "¿Hablas español?"],
        ["No ho entenc.", "No ho entenc.", "no u en-TENK", "No lo entiendo."]
      ]},
      {"nivel": "A2", "titulo": "Vida diaria: pasado perifrástico, futuro y pronombres", "puntos": [
        "Pasado perifrástico, propio del catalán, con 'anar' + infinitivo: 'Ahir vaig anar al port' (ayer fui al puerto). ¡No es futuro!",
        "Pretèrit perfet para hoy y periodos abiertos: 'Avui he treballat molt'.",
        "Futuro simple (parlaré) y futuro cercano con 'anar a' + infinitivo: 'Demà treballaré'.",
        "Pronombres débiles: em, et, es, ens, us, el, la, li, els, ho; 'ho' sustituye a 'lo' neutro: 'No ho sé'.",
        "'Hi' y 'en' sustituyen lugares y cantidades: 'Hi vaig' (voy allí), 'En vull dos' (quiero dos).",
        "Gustos con 'agradar' como en español: 'M'agrada el cafè'."
      ], "ejemplos": [
        ["Ahir vaig anar al port.", "Ahir vaig anar al port.", "a-I bach a-NA al POR", "Ayer fui al puerto."],
        ["Demà treballaré.", "Demà treballaré.", "de-MA tre-ba-lla-RE", "Mañana trabajaré."],
        ["M'agrada el cafè.", "M'agrada el cafè.", "ma-GRA-da el ka-FE", "Me gusta el café."]
      ]},
      {"nivel": "B1", "titulo": "Independencia: imperfecto, subjuntivo y opiniones", "puntos": [
        "Imperfet para costumbres y descripciones del pasado: 'Quan era petit, vivia a prop del mar'.",
