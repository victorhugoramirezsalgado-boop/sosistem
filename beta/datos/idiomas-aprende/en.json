   {"inf": "to eat", "r": "to eat", "es": "comer", "formas": [["yo", "I eat", "ai it"], ["tú", "you eat", "iu it"], ["él/ella", "he/she eats", "ji/shi its"], ["nosotros", "we eat", "ui it"], ["ustedes/vosotros", "you eat", "iu it"], ["ellos/ellas", "they eat", "dei it"]]}
